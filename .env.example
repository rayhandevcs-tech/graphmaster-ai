# Root compose configuration. Copy to .env and fill in.
# Backend-specific settings live in backend/.env.example, frontend-specific
# ones in frontend/.env.example.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ENVIRONMENT=development
DEBUG=true

POSTGRES_USER=graphmaster
POSTGRES_PASSWORD=graphmaster
POSTGRES_DB=graphmaster
DB_PORT=5432

API_PORT=8000
WEB_PORT=3000

# Where the browser reaches the API. Compose passes this to the web image as a
# BUILD argument: Next inlines NEXT_PUBLIC_* into the browser bundle at build
# time, so setting it only on the running container has no effect.
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
