# Root compose configuration. Copy to .env and fill in.
# Backend-specific settings live in backend/.env.example.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ENVIRONMENT=development
DEBUG=true

POSTGRES_USER=graphmaster
POSTGRES_PASSWORD=graphmaster
POSTGRES_DB=graphmaster
DB_PORT=5432

API_PORT=8000
WEB_PORT=3000

ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
