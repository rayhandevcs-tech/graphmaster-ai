# Frontend configuration. Copy to .env.local for local development.
#
# NEXT_PUBLIC_* is inlined into the browser bundle when the app is BUILT, not
# read at runtime — in Docker it is a build argument, not an environment
# variable on the running container.

# Where the API lives, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
