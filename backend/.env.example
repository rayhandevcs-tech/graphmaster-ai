# ─── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1
PROJECT_NAME=GraphMaster
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://graphmaster:graphmaster@localhost:5432/graphmaster
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ─── Authentication ─────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=/media
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# ─── Uploads ────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000

# ─── OCR ────────────────────────────────────────────────────────────────────
OCR_PROVIDER_ORDER=google_vision,easyocr,tesseract
# Optional. Without it, Google Vision is skipped and EasyOCR is used.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-vision.json
EASYOCR_MODEL_DIR=/opt/easyocr
EASYOCR_LANGUAGES=en
TESSERACT_CMD=tesseract

# ─── NLP ────────────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm

# ─── Scoring ────────────────────────────────────────────────────────────────
VOCABULARY_WEIGHT=0.70
WRITING_WEIGHT=0.30
TIER_CROWN_MIN=90
TIER_FLOWER_MIN=60
TIER_STEADY_MIN=50
TARGET_WORD_COUNT_MIN=150
TARGET_WORD_COUNT_MAX=250

# ─── Assessment ─────────────────────────────────────────────────────────────
# Diagnostic only. Nothing here can move a score, a reward tier or an XP award.
ASSESSMENT_ENABLED=true
ASSESSMENT_ANALYZERS=vocabulary,writing,spelling,sentence,word_usage,graph_accuracy,grammar

# Staged rollout, per analyzer, without a redeploy. Anything listed in the
# first runs and is stored but shown to nobody; anything in the second is shown
# to teachers only. Unlisted analyzers are shown to everyone.
ASSESSMENT_DARK_ANALYZERS=
ASSESSMENT_TEACHER_ONLY_ANALYZERS=

# Issues below the floor are stored and counted, but not displayed — so a
# false-positive rate can be tuned from evidence rather than guessed.
ASSESSMENT_ISSUE_CONFIDENCE_FLOOR=0.6
ASSESSMENT_MAX_ISSUES_PER_CATEGORY=25
ASSESSMENT_ANALYZER_BUDGET_MS=250

# ─── Grammar provider ───────────────────────────────────────────────────────
# none | local | remote. Off by default: the local engine needs a JVM and a
# large download, and the remote one posts student writing to a third party.
#
# Grammar analysis is diagnostic. Whichever value this takes, it cannot move
# final_score, XP, a reward tier, an achievement or a leaderboard position —
# see docs/architecture/10-assessment-architecture.md §2.
#
#   local   a LanguageTool HTTP server you run. Nothing leaves your network.
#           docker compose --profile grammar up  starts one on 8081.
#   remote  a hosted LanguageTool. Every answer checked leaves the
#           institution: check your data-protection position before using it.
GRAMMAR_PROVIDER=none

# Where the local engine listens. Ignored when GRAMMAR_API_URL is set, which
# is how a local engine behind a proxy or a path prefix is reached.
GRAMMAR_HOST=localhost
GRAMMAR_PORT=8081

# The remote endpoint, and the override for a local one. A base URL —
# "/v2/check" is appended, and recognised if it is already there. Required
# when GRAMMAR_PROVIDER=remote: the server refuses to start without it rather
# than quietly running with no checker.
GRAMMAR_API_URL=

# The TOTAL budget for one check, retries included — not a per-attempt
# timeout. This call happens inside the request that scores a submission.
GRAMMAR_TIMEOUT_SECONDS=3.0
# Attempts beyond the first, for the remote provider only. Spent inside the
# budget above, never in addition to it. The local provider never retries: a
# refused connection to a host you operate is a service that is down.
GRAMMAR_MAX_RETRIES=1
# Longer answers are truncated for grammar analysis rather than refused.
GRAMMAR_MAX_CHARS=20000
# How long a health probe's answer stands. A negative answer expires, so a
# platform that started before its engine did recovers without a restart.
GRAMMAR_HEALTH_TTL_SECONDS=60
GRAMMAR_LANGUAGE=en-GB

# ── Writing consistency ──────────────────────────────────────────────────────
# Teacher-facing measurement of how one student's writing moves across their
# own submissions. Diagnostic, like everything in the assessment package, and
# additionally never visible to a student — the floor for that is in code
# (NEVER_STUDENT_ANALYZERS), not in the variables below.
#
# It measures and compares; it does not judge. Nothing in it computes a
# probability that text was machine-generated, an authorship decision, or a
# risk value under any name. See docs/architecture/10-assessment-architecture.md
# §15 before switching any of this on.
#
# To measure, add `writing_profile` to ASSESSMENT_ANALYZERS above. It is
# absent from the default on purpose: a deployment gets today's behaviour
# until someone decides otherwise. Start it in ASSESSMENT_DARK_ANALYZERS —
# the feature needs a term of history before it has anything to report.

# Whether the comparison layer may be called at all. Separate from
# measurement, because the useful order is collect first, expose later.
CONSISTENCY_ANALYTICS_ENABLED=false

# Answers shorter than this are not profiled and never take part in a
# comparison: below it these measures are dominated by noise.
CONSISTENCY_MIN_WORDS=120

# Comparable prior submissions needed before a baseline exists. Below it the
# answer is "no baseline yet" — never a number, and never "consistent".
CONSISTENCY_MIN_BASELINE=3

# Distinct students needed before a class distribution is shown. Below it a
# "distribution" is both statistically meaningless and re-identifying.
CONSISTENCY_MIN_CLASS_SAMPLES=5

# ─── Gamification ───────────────────────────────────────────────────────────
XP_PER_SUBMISSION=20
XP_HIGH_SCORE_BONUS=30
XP_STREAK_BONUS=50
HIGH_SCORE_THRESHOLD=80
MAX_LEVEL=100
# Decides which calendar day a submission belongs to, for streaks and for the
# weekly and monthly boards. Set it to the cohort's own zone so a class rolls
# over together; an unknown zone fails at boot rather than at the first score.
PLATFORM_TIMEZONE=UTC
# How long materialised rankings are served before a read rebuilds them.
LEADERBOARD_CACHE_MINUTES=15

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
